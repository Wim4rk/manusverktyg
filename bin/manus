#!/usr/bin/env bash
set -euo pipefail

# manus — verktyg för att gå från markdown till färdigt manus.
#
# FÖR SKÖNLITTERATUR. Allt här förutsätter en roman eller novell: kapitel i
# läsordning, repliker och berättande. Facklitteraturens korsreferenser,
# källhänvisningar och register hanteras inte alls.
#
#   manus lint       städar texten: en mening per rad, ett stycke per tomrad
#   manus pratminus  gör om citatrepliker till pratminus
#   manus bygg       kör Pandoc på alla numrerade dokument i katalogträdet
#
# Det här är bara vägvisaren. Själva arbetet ligger i lib/, och de
# gemensamma byggtillgångarna (stilmall, lua-filter) i assets/.

# Följ symlänken hela vägen hem. Kommandot är tänkt att ligga som en länk i
# ~/.local/bin, och då pekar $BASH_SOURCE på länken — inte på projektet där
# lib/ och assets/ faktiskt finns.
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MANUS_ROOT="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
export MANUS_ROOT

readonly PROGNAME="manus"

show_help() {
    cat <<EOF
$PROGNAME — från markdown till färdigt manus. För skönlitteratur.

ANVÄNDNING
    $PROGNAME <kommando> [FLAGGOR]

    Verktygen förutsätter ett skönlitterärt manus: kapitel i läsordning,
    repliker och berättande. Facklitteraturens korsreferenser, register
    och källhänvisningar hanteras inte.

KOMMANDON
    lint     Städar texten. Lägger varje mening på en egen rad och skiljer
             stycken åt med exakt en tomrad. Rör aldrig originalet om du
             inte ber om det.
                 $PROGNAME lint --help

    pratminus
             Gör om citatrepliker till pratminus: ”Hej?” sa hon blir
             -- Hej? sa hon. Rör aldrig originalet utan --in-place.
                 $PROGNAME pratminus --help

    bygg     Kör Pandoc på alla dokument i katalogträdet vars namn börjar
             med tre siffror, i nummerordning. Bygger EPUB, PDF eller DOCX.
                 $PROGNAME bygg --help

    hjälp    Den här texten. Även -h och --help.

SNABBSTART
    Ställ dig i bokens katalog:

        $PROGNAME bygg --lista          # kontrollera kapitelordningen
        $PROGNAME bygg --lint -o bok.pdf -- --pdf-engine=xelatex --toc

VAR SAKER LIGGER
    Projektet:      $MANUS_ROOT
    Byggtillgångar: $MANUS_ROOT/assets
EOF
}

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

subcommand="$1"
shift

case "$subcommand" in
    lint)
        MANUS_COMMAND="$PROGNAME lint" exec "$MANUS_ROOT/lib/lint.sh" "$@"
        ;;
    pratminus)
        MANUS_COMMAND="$PROGNAME pratminus" exec "$MANUS_ROOT/lib/pratminus.sh" "$@"
        ;;
    bygg)
        MANUS_COMMAND="$PROGNAME bygg" exec "$MANUS_ROOT/lib/bygg.sh" "$@"
        ;;
    hjälp|hjalp|-h|--help|help)
        show_help
        ;;
    version|--version)
        echo "$PROGNAME (manusverktyg)"
        ;;
    *)
        echo "$PROGNAME: okänt kommando '$subcommand'" >&2
        echo "Kör '$PROGNAME hjälp' för vilka som finns." >&2
        exit 1
        ;;
esac
